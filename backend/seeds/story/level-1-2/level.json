  "slides": [
    {
      "kind": "SLIDE",
      "eyebrow": "Chapter 1 · The night they came",
      "heading": "Out of the fire",
      "image": "01-out-of-the-fire.webp",
      "palette": {
        "background": "#0a0807",
        "glow": "#f9731633",
        "accent": "#fb923c"
      },
      "body": "He crashes through the burning door and falls into the yard, coughing smoke out of his chest. The bandit who blocked the door lies in the dirt and does not get up. For one breath the night air feels like freedom. Then he hears the laughter."
    },
    {
      "kind": "SLIDE",
      "eyebrow": null,
      "heading": "The big one",
      "image": "02-the-big-one.webp",
      "palette": {
        "background": "#0b0806",
        "glow": "#f59e0b33",
        "accent": "#fbbf24"
      },
      "body": "The riders part to let someone through. He is the biggest man the boy has ever seen, with arms like tree trunks and a blacksmith's hammer resting on one shoulder. He looks at the fallen bandit, then at the boy, and smiles like he has been given a gift."
    },
    {
      "kind": "SLIDE",
      "eyebrow": null,
      "heading": "Nowhere to run",
      "image": "03-nowhere-to-run.webp",
      "palette": {
        "background": "#0b0605",
        "glow": "#ef444433",
        "accent": "#f87171"
      },
      "body": "The riders form a circle around the yard, torches held high, horses stamping. Behind him the house is a wall of fire. In front of him is the hammer. There is no road out tonight that does not go through that man."
    },
    {
      "kind": "SLIDE",
      "eyebrow": null,
      "heading": "One hit",
      "image": "04-one-hit.webp",
      "palette": {
        "background": "#0a0706",
        "glow": "#fb923c40",
        "accent": "#fdba74"
      },
      "body": "The first swing misses and turns an old cart into splinters. The ground shakes under the blow. The boy understands something very quickly: if that hammer lands even once, he will not get up again."
    },
    {
      "kind": "SLIDE",
      "eyebrow": null,
      "heading": "Small and fast",
      "image": "05-small-and-fast.webp",
      "palette": {
        "background": "#07090b",
        "glow": "#2dd4bf26",
        "accent": "#5eead4"
      },
      "body": "The man is strong, but he is slow, and every swing pulls him off balance. The boy is small, and hunger has made him light on his feet. Stay out of reach. Wait for the miss. Hit him while the hammer is still coming back."
    },
    {
      "kind": "CALL_TO_ACTION",
      "eyebrow": null,
      "heading": "Make him miss.",
      "image": "06-call-to-action.webp",
      "palette": {
        "background": "#0a0807",
        "glow": "#f9731659",
        "accent": "#f97316"
      },
      "button_label": "Play",
      "body": "The hammer is heavier than the boy, and the man swinging it has never lost. One hit could end it. Make him miss, and make him pay for it."
    }
  ]
}
